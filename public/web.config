<?xml version="1.0" encoding="UTF-8"?>
<!--
    Configuracion de IIS para SGC Calidad.

    Este archivo va en la carpeta public/, que es la raiz del sitio en IIS.
    Sin el, IIS devuelve 404 en cualquier ruta que no sea un archivo real:
    Laravel enruta todo por index.php y eso necesita el modulo URL Rewrite 2.1.

    Requiere en IIS:  CGI (FastCGI) + URL Rewrite 2.1

    Se mantiene deliberadamente corto. Cada seccion extra en un web.config es
    una via de error 500.19 si el servidor tiene esa seccion bloqueada; el
    endurecimiento opcional esta documentado en DESPLIEGUE.md.
-->
<configuration>
    <system.webServer>

        <rewrite>
            <rules>
                <!--
                    Quita la barra final de las URL, salvo cuando corresponde a
                    un directorio real. Evita que /lotes/ y /lotes se traten
                    como dos direcciones distintas.
                -->
                <rule name="Quitar barra final" stopProcessing="true">
                    <match url="^(.*)/$" ignoreCase="false" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                    </conditions>
                    <action type="Redirect" redirectType="Permanent" url="/{R:1}" />
                </rule>

                <!--
                    Todo lo que no sea un archivo o directorio existente lo
                    atiende el front controller de Laravel.
                -->
                <rule name="Front controller de Laravel" stopProcessing="true">
                    <match url="^" ignoreCase="false" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php" />
                </rule>
            </rules>
        </rewrite>

        <!--
            Deja que Laravel muestre sus propias paginas de error en lugar de
            las genericas de IIS. Sin esto, un certificado inexistente se ve
            como una pantalla de IIS y no como la del sistema.
        -->
        <httpErrors existingResponse="PassThrough" />

        <staticContent>
            <!--
                IIS no sirve woff2 por defecto en todas las versiones. Sin esto
                las tipografias no cargan y la boleta impresa cambia de aspecto.
                Se quita primero para no chocar si ya venia declarado.
            -->
            <remove fileExtension=".woff" />
            <remove fileExtension=".woff2" />
            <remove fileExtension=".svg" />
            <mimeMap fileExtension=".woff" mimeType="font/woff" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
            <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
        </staticContent>

        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
            </customHeaders>
        </httpProtocol>

    </system.webServer>
</configuration>
